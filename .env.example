# Copy to .env (gitignored) and choose your own local password.
# These are LOCAL DEVELOPMENT DATABASE credentials only, and every developer picks their own.
# Never put API keys here: market-data keys are set as environment variables for one shell
# session, and paper-trading keys live in the OS keyring (see CONTRIBUTING.md section 2).
# The password appears three times below; keep all three identical.
TRADER_PG_USER=trader
TRADER_PG_PASSWORD=change-me-local-only
TRADER_PG_DB=trader
TRADER_PG_PORT=5433

# Runtime database used by `trader` commands that persist state (paper mode requires PostgreSQL).
TRADER_DATABASE_URL=postgresql+psycopg://trader:change-me-local-only@127.0.0.1:5433/trader
# Test database (created by deploy/postgres-init on the container's first start).
TRADER_TEST_DATABASE_URL=postgresql+psycopg://trader:change-me-local-only@127.0.0.1:5433/trader_test

# Host role: DEV (replay/shadow/paper allowed), PAPER (no live), LIVE (live only).
TRADER_HOST_ROLE=DEV

# Intel feed (ADR-0047): the SEC asks automated EDGAR readers to name a contact address. One
# plain email address, your own. Without this line insider filings are skipped; news and
# pre-market data still work.
# SEC_EDGAR_CONTACT=you@example.com

# ---- Optional, all commented out. Placeholders only: never commit real values. ----

# Which stocks book `npm run bot` trades and the console shows (default: the exploration book).
# TRADER_PAPER_CONFIG=configs/paper_explore.yaml

# The bare `trader` CLI does not read this file; `npm run bot` and `npm run dev` do, and they
# derive these two from TRADER_DATABASE_URL. Set them in your shell only when you call
# `uv run trader paper ...` yourself.
# TRADER_EXPLORE_DATABASE_URL=postgresql+psycopg://trader:change-me-local-only@127.0.0.1:5433/trader_explore
# TRADER_PRACTICE_DATABASE_URL=postgresql+psycopg://trader:change-me-local-only@127.0.0.1:5433/trader_practice

# Capital.com DEMO account, for the practice trader (`npm run trader`). Demo only: the API host
# is hard-coded to the demo server.
# CAP_API_KEY=your-demo-api-key
# CAP_IDENTIFIER=your-demo-login
# CAP_API_PASSWORD=your-demo-api-password

# Alpha Vantage, only for the assistant's research data connection (ADR-0039).
# ALPHA_VANTAGE_API_KEY=your-key

# Alpaca paper keys do NOT go here. Store them in the OS keyring:
#   uv run trader secrets set alpaca-paper
