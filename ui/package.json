{
  "name": "trader-console",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only localhost console for the ai-stock-trader bot (docs/observability.md).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --prod",
    "desk": "node scripts/dev.mjs --open=/desk",
    "server": "tsx watch server/index.ts --dev",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "shots": "node e2e/shoot.mjs"
  },
  "dependencies": {
    "@fastify/middie": "^9.3.6",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "d3-sankey": "~0.12.3",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.8",
    "hyparquet": "^1.32.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "motion": "^12.43.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "three": "^0.187.0",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "meshoptimizer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
